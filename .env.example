# Run immediately without API keys or GPU downloads.
# Generation and search are independent: live/demo recreates the narrated demo.
GENERATION_MODE=demo
SEARCH_MODE=demo
HOST=127.0.0.1
PORT=8888

# Live generation: accept the model's terms on Hugging Face, then set a token
# with read access. Never commit the resulting .env file.
HF_TOKEN=
MODEL_DEVICE=auto
QUANTIZE_4BIT=true
CPU_OFFLOAD=true
INFERENCE_STEPS=40
IMAGE_SIZE=1024

# Live search: both keys are required. Searches publish the submitted image
# to a publicly accessible ImgBB URL, then pass that URL to SerpAPI.
IMGBB_API_KEY=
SERPAPI_API_KEY=
IMGBB_EXPIRATION=600
